# ── 配置模板（复制为 .env 后填真实值）─────────────
# ⚠️ .env 已被 .gitignore，永远不会进仓库；config.json 同理，别再往里写真 token
# ⚠️ 本文件只放占位符，别在这里填真实值

# ── Telegram ──────────────────────────────
# Bot token，找 @BotFather 拿。如怀疑泄露：@BotFather → /mybots → Revoke 换新的
TG_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# 公开频道/群 chatId：@handle 或 -100 开头的数字
TG_CHAT_ID=@your_public_channel
# 会员频道 chatId（可选）。不配 = 不分开免费/会员档，只发免费版
TG_MEMBER_CHAT_ID=

# ── 调度 ─────────────────────────────────
# 推送间隔（分钟）。720 = 12 小时。**配了 PUSH_TIMES 后本项忽略**
SCHEDULE_MINUTES=720
# 定点推送时刻（本地时间 HH:MM，逗号分隔）。配了就按这个推，忽略 SCHEDULE_MINUTES。
# 中文用户活跃时段建议 08:30 和 20:30。留空 = 用上面的间隔模式。
# 特性：机器暂停错过会补推（只补最近一次），已推过的时刻不会重复
PUSH_TIMES=
# 状态目录（源记忆/已读去重/上次推送时间）。云端必须指向持久盘：
#   STATE_DIR=/data/home/chain-intel-bot/state
# 留空则用 <项目>/state（本地默认）
STATE_DIR=

# ── USDC 收款 ────────────────────────────
USDC_RECEIVE_ADDRESS=0xYOUR_USDC_ADDRESS_HERE
USDC_MONTHLY_PRICE=9

# ── 保活端点（仅云端部署需要）──────────────
# keepalive.js 监听的端口；InstaBox 开公网端口时选同一个
KEEPALIVE_PORT=8080
# 保活密钥：外部监控服务 ping 时必须带 ?key=<这个值>。
# 留空 = /ping 一律 403（防陌生人探测/触发你的机器）。建议生成一串随机字符
KEEPALIVE_KEY=
